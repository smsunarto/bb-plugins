node_modules/
.pnpm-store/
dist/
# The vendored agentation build is source, not output: bb's install-time build
# has to find it, and no build step in this repo regenerates it.
!plugins/agentation/vendor/agentation/dist/
out/
.next/
__pycache__/
*.py[cod]
*.tsbuildinfo
.DS_Store
.env
.env.*
# bb writes local project state into .bb/; only the plugin collection
# manifest is ours to track.
.bb/*
!.bb/plugins.json
.claude/
.scratch/

# Amp generates portal metadata separately in each orb.
.amp/portals/*

# One-off verification screenshots belong in .scratch/ or thread storage.
/final-*.png
