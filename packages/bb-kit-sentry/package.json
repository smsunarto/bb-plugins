{
  "name": "@bb-kit/sentry",
  "version": "0.2.0",
  "description": "Privacy-first Sentry error reporting for bb-kit plugins.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "packages/bb-kit-sentry"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "import": "./dist/performance.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    }
  },
  "scripts": {
    "build": "bun build src/app.ts src/context.ts src/node.ts src/performance.ts src/telemetry.ts --root src --outdir dist --target=node --format=esm --packages=external --sourcemap=linked && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run build && bun test --timeout=30000",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sentry/browser": "10.72.0",
    "@sentry/node": "^10.72.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@bb-kit/core": "0.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.0"
  }
}
