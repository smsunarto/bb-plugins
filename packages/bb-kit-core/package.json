{
  "name": "@bb-kit/core",
  "version": "0.1.0",
  "description": "The framework a bb plugin is written in.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "packages/bb-kit-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "bb-kit": "./bin/bb-kit.mjs"
  },
  "exports": {
    "./plugin": {
      "types": "./dist/plugin/plugin.d.ts",
      "import": "./dist/plugin/plugin.js"
    },
    "./rpc": {
      "types": "./dist/rpc/rpc.d.ts",
      "import": "./dist/rpc/rpc.js"
    },
    "./rpc/query": {
      "types": "./dist/rpc/query/query.d.ts",
      "import": "./dist/rpc/query/query.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "import": "./dist/cli/cli.js"
    },
    "./testing": {
      "types": "./dist/testing/testing.d.ts",
      "import": "./dist/testing/testing.js"
    }
  },
  "scripts": {
    "build": "bun build src/bin/bin.ts src/plugin/plugin.ts src/rpc/rpc.ts src/rpc/query/query.ts src/cli/cli.ts src/testing/testing.ts --root src --outdir dist --target=node --format=esm --packages=external --sourcemap=linked && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --import tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "peerDependencies": {
    "@get-bb/plugin-sdk": "0.x",
    "@tanstack/react-query": "^5.0.0",
    "jsdom": "*",
    "react": ">=19",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@tanstack/react-query": "^5.101.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "zod": "^4.4.3"
  }
}
