{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "smsunarto",
  "displayName": "smsunarto's bb plugins",
  "description": "Plugins for bb: agents, GitHub stacks, notifications, themes.",
  "plugins": [
    {
      "id": "agentation",
      "displayName": "Agentation",
      "description": "Point at any part of the bb UI — including plugin surfaces — and turn it into structured AFS 1.1 feedback that bb agents can read, answer, and resolve.",
      "icon": {
        "url": "plugins/agentation/assets/icon.svg"
      },
      "author": {
        "name": "Scott Sunarto",
        "github": "smsunarto"
      },
      "source": {
        "git": {
          "url": "https://github.com/smsunarto/bb-plugins",
          "subdir": "plugins/agentation",
          "range": "*",
          "tagPrefix": "agentation/"
        }
      }
    },
    {
      "id": "devin",
      "displayName": "Devin",
      "description": "Runs Devin as a bb provider, on your machine or on a Devin Cloud VM, through the SDK's ACP bridge.",
      "icon": {
        "url": "plugins/devin/assets/icon.svg"
      },
      "author": {
        "name": "Scott Sunarto",
        "github": "smsunarto"
      },
      "source": {
