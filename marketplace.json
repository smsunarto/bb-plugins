{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "smsunarto",
  "displayName": "smsunarto's bb plugins",
  "description": "Plugins for bb: agents, GitHub stacks, notifications, themes.",
  "plugins": [
    {
      "id": "agent-proxy",
      "displayName": "Agent Proxy",
      "description": "Run CLIProxyAPI as a persistent macOS or Linux service with OAuth accounts, providers, usage, and agent wiring.",
      "icon": {
        "url": "plugins/agent-proxy/assets/icon.svg"
      },
      "author": {
        "name": "Scott Sunarto",
        "github": "smsunarto"
      },
      "source": {
        "git": {
          "url": "https://github.com/smsunarto/bb-plugins",
          "subdir": "plugins/agent-proxy",
          "range": "*",
          "tagPrefix": "agent-proxy/"
        }
      }
    },
    {
      "id": "agentation",
      "displayName": "Agentation",
      "description": "Point at any part of the bb UI \u2014 including plugin surfaces \u2014 and turn it into structured AFS 1.1 feedback that bb agents can read, answer, and resolve.",
      "icon": {
        "url": "plugins/agentation/assets/icon.svg"
      },
      "author": {
        "name": "Scott Sunarto",
        "github": "smsunarto"
      },
      "source": {
        "git": {
          "url": "https://github.com/smsunarto/bb-plugins",
          "subdir": "plugins/agentation",
          "range": "*",
          "tagPrefix": "agentation/"
        }
      }
    },
    {
      "id": "amp",
      "displayName": "Amp",
      "description": "Runs Amp locally or in an Orb as one bb provider through the plugin's own provider bridge, which spawns the Amp CLI directly.",
      "icon": {
        "url": "plugins/amp/assets/icon.svg"
      },
      "author": {
        "name": "Scott Sunarto",
        "github": "smsunarto"
      },
      "source": {
        "git": {
          "url": "https://github.com/smsunarto/bb-plugins",
          "subdir": "plugins/amp",
          "range": "*",
          "tagPrefix": "amp/"
        }
      }
    },
    {
      "id": "gh-stack",
      "displayName": "GitHub Stack",
      "description": "Visualize and drive stacked pull requests (gh stack) from BB threads.",
      "icon": {
        "url": "plugins/gh-stack/assets/icon.svg"
      },
      "author": {
        "name": "Scott Sunarto",
        "github": "smsunarto"
