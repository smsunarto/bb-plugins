#!/usr/bin/env bash
# The bb CLI of the pinned screenshot worktree, for BB_CLI.
#
# Two things have to be true for a screenshot run to be reproducible, and this
# script is where both are enforced.
#
# The ambient environment is cleared first. A shell inside a bb thread exports
# BB_SERVER_URL and BB_CLI pointing at the desktop app, and the dev CLI honours
# them — so without `env -u` this silently drives the developer's real bb and
# reports its personal plugin set as if it were the fixture instance.
#
# The worktree is pinned second. It is checked out at a release commit rather
# than at main, so the captures show the bb that users actually run instead of
# whatever is landing this week.
set -euo pipefail

# Under bb's own worktrees directory rather than beside the source checkouts:
# this is a fixture, not something anyone edits, and it should not sit in the
# working directory as if it were.
repo="${BB_SCREENSHOT_REPO:-${HOME}/.bb/worktrees/screenshots/bb}"

if [[ ! -d "${repo}" ]]; then
  echo "bb-screenshot-cli: no worktree at ${repo}" >&2
  echo "Create one, or point BB_SCREENSHOT_REPO at an existing checkout." >&2
  exit 1
fi

# `bb:dev` sends its build chatter to stderr already, so stdout stays parseable
# JSON for the callers that ask for --json.
exec env \
  -u BB_SERVER_URL \
  -u BB_CLI \
  -u BB_THREAD_ID \
  -u BB_ENVIRONMENT_ID \
  -u BB_THREAD_STORAGE \
  -u BB_PROJECT_ID \
  pnpm -C "${repo}" --silent bb:dev "$@"
