$speed = 1
planets = [
  {name: "Mercury", r: 1.2, size: 0.12, years: 0.24, phase: 0.4, color: "#a8a29e"},
  {name: "Venus", r: 1.8, size: 0.19, years: 0.62, phase: 2.6, color: "#e7c78f"},
  {name: "Earth", r: 2.5, size: 0.2, years: 1, phase: 4.4, color: "#3b82f6"},
  {name: "Mars", r: 3.2, size: 0.16, years: 1.88, phase: 1.3, color: "#c2410c"},
  {name: "Jupiter", r: 4.3, size: 0.42, years: 11.86, phase: 3.5, color: "#d6a77a"},
  {name: "Saturn", r: 5.4, size: 0.36, years: 29.46, phase: 5.6, color: "#e9d8a6"}
]
// One Earth year takes 10 seconds at speed 1; each planet starts at its own phase, so names never stack.
angle = (p, t) => p.phase + TAU * t * $speed / (10 * p.years)
place = (p, t) => [p.r * cos(angle(p, t)), 0, -p.r * sin(angle(p, t))]
circle = (center, r, y) => range(0, 65).map(i => [center[0] + r * cos(i * TAU / 64), y, center[2] + r * sin(i * TAU / 64)])
// The asteroid belt between Mars and Jupiter (fixed here; it would turn too slowly to see).
belt = range(0, 120).map(i => ({shape: "point", at: [(3.55 + 0.45 * random(i + 500)) * cos(random(i) * TAU), (random(i + 1000) - 0.5) * 0.16, (3.55 + 0.45 * random(i + 500)) * sin(random(i) * TAU)], radius: 1, color: "muted"}))
system = t => [
  {shape: "sphere", at: [0, 0, 0], radius: 0.5, color: "#ffb340", glow: 3, detail: 32},
  {shape: "sprite", at: [0, 0, 0], size: 120, color: "#ffb340", glow: 1.2},
  planets.map(p => [
    {shape: "path", points: circle([0, 0, 0], p.r, 0), color: "border"},
    {shape: "sphere", at: place(p, t), radius: p.size, color: p.color, roughness: 0.8},
    {shape: "label", at: [place(p, t)[0], p.size + 0.45, place(p, t)[2]], text: p.name}
  ]),
  // Saturn's rings and Earth's Moon ride along with their planets.
  {shape: "path", points: circle(place(planets[5], t), 0.6, 0), color: "#d6c08f", width: 3},
  {shape: "sphere", at: [place(planets[2], t)[0] + 0.36 * cos(t * $speed * TAU * 1.3), 0, place(planets[2], t)[2] + 0.36 * sin(t * $speed * TAU * 1.3)], radius: 0.06, color: "#d4d4d8"},
  belt
]
Card("The inner planets lap the outer ones", [
  Scene(system, height: 380, camera: {yaw: 0.3, pitch: 0.7}),
  Slider($speed, 0, 5, 0.25, label: "Speed (Earth years per 10 s)"),
  Text("Orbital periods are to scale; sizes and distances are not. Mercury goes round four times for each Earth year, Saturn once in 29.")
])
