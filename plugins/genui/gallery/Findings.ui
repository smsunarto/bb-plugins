Findings([
  {severity: "critical", title: "load_report opens any path it is given", file: "data/src/durations.py", line: 48, column: 14, rule: "path-traversal", detail: "The report path comes from the test runner's arguments. Resolve it under the workspace before opening, or a crafted path reads any file the agent can.", fix: "root = Path(workspace).resolve()\ntarget = (root / path).resolve()\nif root not in target.parents:\n    return {}\nwith open(target) as handle:\n    return json.load(handle)"},
  {severity: "high", title: "fitView drops the zoom it computed", file: "data/src/mapMath.ts", line: 74, column: 20, detail: "`zoom` is computed on line 73 but never passed to `clampView`, so every fitted map opens at the minimum zoom.", fix: "--- a/data/src/mapMath.ts\n+++ b/data/src/mapMath.ts\n@@ -73,2 +73,2 @@\n   const zoom = Math.min(maxZoom, zoomFor(maxX - minX, width), zoomFor(maxY - minY, height));\n-  return clampView({ x: (minX + maxX) / 2, y: (minY + maxY) / 2 }, size);\n+  return clampView({ x: (minX + maxX) / 2, y: (minY + maxY) / 2, zoom }, size);"},
  {severity: "medium", title: "Loose equality in zoomFor", file: "data/src/mapMath.ts", line: 72, column: 59, endColumn: 61, rule: "eqeqeq", url: "https://eslint.org/docs/latest/rules/eqeqeq"},
  {severity: "low", title: "Unused debug option on pan()", file: "data/src/mapMath.ts", line: 88, column: 69},
  {severity: "info", title: "summarize re-reads every status", detail: "Not a bug: fine at today's sizes; worth a `Counter` if reports grow past a few thousand tests."}
], "Review: map math and test durations")
