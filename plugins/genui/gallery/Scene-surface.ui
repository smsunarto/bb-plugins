$sea = 0.1
height = (x, z) => 0.9 * sin(x * 1.1) * cos(z * 0.9) + 0.35 * sin(x * 1.7 + z * 1.3) + 0.3
// Land share from a 30 × 30 sample of the same function the surface draws.
samples = range(0, 30).map(i => range(0, 30).map(j => height(-2.9 + i * 0.2, -2.9 + j * 0.2) > $sea ? 1 : 0))
land = sum(samples.map(row => sum(row))) / 9
Card("Island at a rising sea", [
  Scene([
    // Lowland green, then grass, rock and snow by height.
    {shape: "surface", x: [-3, 3], z: [-3, 3], f: height, detail: 96, colors: ["#2f6b3f", "#7a9a4f", "#9c8064", "#f2f1ee"], roughness: 0.9},
    {shape: "box", at: [0, ($sea - 1.3) / 2, 0], size: [6, $sea + 1.3, 6], color: "#38bdf8", glass: true, ior: 1.33},
    {shape: "point", at: [1.4, height(1.4, 0) + 0.06, 0], radius: 4, color: "text", hint: "Peak, " + fmt(height(1.4, 0) * 100) + " m"}
  ], height: 360, camera: {yaw: 0.7, pitch: 0.6}),
  Slider($sea, -1, 1.2, 0.05, label: "Sea level"),
  Metric("Land above water", fmt(land) + "%", tone: land < 25 ? "bad" : land < 50 ? "warn" : "good")
])
