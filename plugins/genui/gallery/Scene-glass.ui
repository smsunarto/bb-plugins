spectrum = ["#ff3b30", "#ff9500", "#ffd60a", "#30d158", "#0a84ff", "#7d5cff"]
// A beam as a thin glowing box from `from`, `angle` radians above the x axis.
beam = (from, angle, length, color, glow) => ({shape: "box", at: [from[0] + length / 2 * cos(angle), from[1] + length / 2 * sin(angle), 0], size: [length, 0.025, 0.025], rotate: [0, 0, angle * 180 / PI], color: color, glow: glow})
// Violet bends most, so it leaves at the steepest angle.
exit = i => -(0.17 + i * 0.065)
Card("A prism splits white light", [
  Scene([
    {shape: "mesh", vertices: [[-0.7, 0, -0.5], [0.7, 0, -0.5], [0, 1.2, -0.5], [-0.7, 0, 0.5], [0.7, 0, 0.5], [0, 1.2, 0.5]], faces: [[0, 2, 1], [3, 4, 5], [0, 1, 4, 3], [1, 2, 5, 4], [2, 0, 3, 5]], color: "#eef6ff", glass: true, ior: 1.5, dispersion: 1},
    {shape: "box", at: [0, -0.04, 0], size: [1.9, 0.08, 1.4], color: "#1f2937", roughness: 0.25, metal: 0.3},
    {shape: "box", at: [-3.45, 0.17, 0], size: [0.5, 0.32, 0.36], rotate: [0, 0, 8], color: "#374151", roughness: 0.3, metal: 0.8},
    beam([-3.2, 0.2], atan2(0.4, 2.85), 2.88, "#ffffff", 3),
    beam([-0.35, 0.6], 0, 0.7, "#ffffff", 1),
    spectrum.map((color, i) => [
      beam([0.35, 0.6], exit(i), 2.8, color, 3),
      {shape: "sprite", at: [0.35 + 2.8 * cos(exit(i)), 0.6 + 2.8 * sin(exit(i)), 0], size: 36, color: color, glow: 2}
    ])
  ], height: 340, camera: {yaw: 0.2, pitch: 0.25}),
  Text("Glass slows short wavelengths more than long ones, so each colour bends by a different angle at both faces: red least, violet most (dispersion).")
])
