{
  "name": "@smsunarto/bb-plugin-genui",
  "version": "0.3.1",
  "description": "BB plugin: agents answer with charts, diagrams, maps, plans and forms rendered inline in the chat.",
  "keywords": [
    "bb-plugin",
    "generative-ui",
    "inline-ui",
    "charts",
    "diagrams",
    "components"
  ],
  "author": "ComicBit",
  "license": "Apache-2.0",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/genui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/genui"
  },
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Generative UI",
    "description": "Lets agents answer with interactive UI rendered inline in chat.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      },
      "experimental_icons": {
        "plugin": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@shaderfrog/glsl-parser": "^7.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "@bb-plugins/instructions": "workspace:*"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.54",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^27.4.0",
    "playwright-core": "1.63.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "private": true,
  "contributors": [
    "Scott Sunarto"
  ],
  "files": [
    "dist/",
    "assets/",
    "components/",
    "core/",
    "gallery/",
    "hooks/",
    "lib/",
    "project/",
    "ui/",
    "web/",
    "instructions/",
    "*.ts",
    "*.tsx",
    "*.css",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE"
  ]
}
