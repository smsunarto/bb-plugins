{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "data-source.ts",
    "fallback.ts",
    "app.tsx",
    "instructions.ts",
    "*.test.ts",
    "vitest.config.ts",
    "test-setup.ts",
    "core",
    "ui",
    "components",
    "lib",
    "hooks",
    "web",
    "project"
  ]
}
