{
  "name": "@smsunarto/bb-plugin-canvas",
  "version": "0.1.0",
  "description": "Render .canvas.mdx files as durable analytical artifacts beside the chat: markdown plus a fixed set of tables, charts, callouts, diffs, and persisted controls.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/canvas",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/canvas"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "canvas",
    "mdx",
    "charts",
    "artifacts"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.41.0 <1.0.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Canvas",
    "description": "Open a .canvas.mdx file beside the chat as a rendered artifact with tables, charts, callouts, diffs, and persisted controls.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "assets/",
    "README.md",
    "LICENSE",
    "src/server/",
    "src/app/",
    "src/shared/",
    "skills/"
  ],
  "dependencies": {
    "@bb-kit/core": "0.1.0",
    "@tanstack/react-query": "^5.101.4",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.34",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "16.3.2",
    "@types/estree": "^1.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "acorn": "^8.18.0",
    "bun-types": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "25.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "dev": "\"${BB_CLI:?Run bun run dev from the repository root}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-core/src/bin/bin.ts check",
    "reference": "bun scripts/reference.ts",
    "clean": "rm -rf dist"
  }
}
