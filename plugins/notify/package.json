{
  "name": "@smsunarto/bb-plugin-notify",
  "version": "0.2.2",
  "description": "Native macOS notifications when a BB thread finishes or fails, plus a notify_user agent tool and a `bb notify` command.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/notify",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/notify"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "notifications",
    "desktop-notifications",
    "macos"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bb": ">=0.40.0 <1.0.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Notify",
    "description": "Native macOS notifications when a BB thread finishes or fails, plus a notify_user agent tool and a `bb notify` command.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server/server.ts",
    "app": "./app/app.tsx",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server/",
    "app/"
  ],
  "dependencies": {
    "@bb-kit/core": "0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bun ../../scripts/dev-plugin.ts",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx",
    "check": "node --import tsx ../../packages/bb-kit-core/src/bin/bin.ts check",
    "verify": "oxlint && tsc --noEmit && node --test --import tsx && node --import tsx ../../packages/bb-kit-core/src/bin/bin.ts check && bb plugin build . && bun pm pack --dry-run",
    "clean": "rm -rf dist"
  }
