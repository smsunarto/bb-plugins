{
  "name": "@smsunarto/bb-plugin-captain",
  "version": "0.1.0",
  "private": true,
  "description": "A long-lived bb thread that runs crew threads for you: briefs them, checks their claims, and tells you only what needs you.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/captain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/captain"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.50.0 <1.0.0",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Captain",
    "description": "A long-lived thread that directs crew threads across your repos, with its own rules and Drive.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "captain": "./assets/captain-glyph.svg"
      },
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "skills": [
      "skills"
    ],
    "app": "./src/app/app.tsx"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "dist/*.map",
    "assets/",
    "instructions/",
    "skills/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@bb-plugins/instructions": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bb-plugins/ui": "workspace:*",
    "@get-bb/plugin-sdk": "0.6.157",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.0",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/plugins-captain.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist"
  }
}
