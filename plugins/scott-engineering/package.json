{
  "name": "@smsunarto/bb-plugin-scott-engineering",
  "version": "0.1.0",
  "description": "Scott\u2019s engineering workflows with native Arena and independent review in BB.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/scott-engineering",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/scott-engineering"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.46.0 <1.0.0",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Scott Engineering",
    "description": "Arena, independent design and implementation reviews, engineering skills, and shared principles.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "host": "./src/host/host.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "instructions/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills/",
    "references/"
  ],
  "dependencies": {
    "@bb-kit/core": "0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "\"${BB_CLI:?Run bun run dev from the repository root}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/server/server.test.ts src/server/command/principle.test.ts src/server/lib/*.test.ts && bun test --preload ./test/sqlite-preload.js src/server/command/review-start.test.ts src/host src/app --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  },
  "private": true
}
