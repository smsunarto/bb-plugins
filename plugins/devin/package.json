{
  "name": "@smsunarto/bb-plugin-devin",
  "version": "0.2.0",
  "description": "Devin as a bb provider, running on your machine or on a Devin Cloud VM.",
  "keywords": [
    "bb",
    "bb-plugin",
    "devin",
    "cognition",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/devin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/devin"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bb": ">=0.47.0 <1.0.0",
    "bbPluginSdk": ">=0.6.75"
  },
  "bbPluginBuild": {
    "experimental_cssScope": "owned-root-v1"
  },
  "bb": {
    "name": "Devin",
    "description": "Runs Devin threads in bb, locally or on a Devin Cloud VM",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "host": "./src/host/host.ts"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "instructions/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@bb-plugins/instructions": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bb-plugins/testing": "workspace:*",
    "@get-bb/plugin-sdk": "0.6.94",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts' && bun test src/app --timeout=30000",
    "clean": "rm -rf dist"
  }
}
