{
  "name": "@smsunarto/bb-plugin-unity",
  "version": "0.1.0",
  "description": "Coordinate Unity Editor ownership and checkout slots across BB threads.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/unity",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/unity"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "unity",
    "worktrees",
    "mppm"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.44.0 <1.0.0",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Unity",
    "description": "Coordinate Unity Editor ownership and checkout slots across BB threads.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "host": "./src/host/host.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/host.js",
    "dist/host.meta.json",
    "src/server/",
    "src/host/",
    "src/shared/",
    "skills/",
    "instructions/",
    "README.md",
    "LICENSE",
    "assets/"
  ],
  "dependencies": {
    "@bb-kit/core": "0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^12.0.0",
    "bun-types": "^1.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "\"${BB_CLI:?Run bun run dev from the repository root}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/sqlite-preload.js src --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  }
}
