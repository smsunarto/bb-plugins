{
  "name": "@smsunarto/bb-plugin-whiteboard",
  "version": "0.1.0",
  "description": "Whiteboard for bb: agents author code walkthroughs, diagrams, and Diff lenses that render beside the thread.",
  "private": true,
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/whiteboard#readme",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/whiteboard"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "whiteboard",
    "code-review",
    "diagrams"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.44.0 <1.0.0",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Whiteboard",
    "description": "Agents author code walkthroughs, diagrams, and Diff lenses that render beside the thread.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "host": "./src/host/host.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "skills/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "\"${BB_CLI:?Run bun run dev from the repository root}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bb-kit/core": "0.2.0",
    "@bb-plugins/markdown-prose": "workspace:*",
    "@dev.fast/diffr": "0.1.3",
    "@hono/node-server": "2.0.12",
    "@mr_mint/elkjs-libavoid": "0.5.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@speed-highlight/core": "1.2.15",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@xyflow/react": "12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "0.11.1",
    "fuzzysort": "4.0.2",
    "git-url-parse": "16.1.0",
    "hono": "4.13.5",
    "jpeg-js": "0.4.4",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pngjs": "7.0.0",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.8.0",
    "tailwind-merge": "^3.4.0",
    "tiptap-markdown": "^0.8.10",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.0.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^1.7.4",
    "tsx": "4.23.12",
    "typescript": "^6.0.0",
    "vitest": "^4.1.1"
  }
}
