{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@bb/plugin-sdk": [
        "./types/bb-plugin-sdk.d.ts"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    ".storybook/**/*.ts",
    "scripts/**/*.ts",
    "server.ts",
    "storybook/**/*.ts",
    "types"
  ]
}
