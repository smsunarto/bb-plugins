{
  "name": "@smsunarto/bb-plugin-amp",
  "version": "0.4.2",
  "description": "Amp (ampcode.com) as a bb provider: a native provider bridge spawning the Amp CLI directly, with Oracle and Orb surfaces",
  "keywords": [
    "bb",
    "bb-plugin",
    "amp",
    "ampcode",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/amp#readme",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/amp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.40.0 <1.0.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Amp",
    "description": "Runs Amp threads in bb through the plugin's native provider bridge",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "dist/host.js",
    "dist/host.meta.json",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.ts",
    "app.tsx",
    "app.css",
    "host.ts",
    "lib/",
    "src/"
  ],
  "dependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "25.0.1",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "dev": "bun ../../scripts/dev-plugin.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000 test/*.test.ts",
    "build": "bb plugin build .",
    "clean": "rm -rf dist"
  }
}
