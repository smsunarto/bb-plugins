{
  "name": "@smsunarto/bb-plugin-prompt-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Inspect and edit the agent instructions, tool descriptions, and skills your plugins give agents.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/prompt-editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/prompt-editor"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.44.0 <1.0.0",
    "bbPluginSdk": ">=0.5.26"
  },
  "bb": {
    "name": "Prompt Editor",
    "description": "Inspect and edit the agent instructions, tool descriptions, and skills your plugins give agents.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@bb-kit/core": "workspace:*",
    "zod": "^4.4.3",
    "@tanstack/react-query": "^5.101.4"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  }
}
