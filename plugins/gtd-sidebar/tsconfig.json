{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "bun-types/test", "bun-types/sqlite"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    },
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "server.ts",
    "host.ts",
    "app.tsx",
    "types",
    "app",
    "shared",
    "components",
    "hooks",
    "lib",
    "test",
    "vitest.config.ts"
  ]
}
