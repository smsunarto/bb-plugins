{
  "name": "@smsunarto/bb-plugin-traces",
  "version": "0.1.0",
  "description": "A keyboard-first Claude Code and Codex trace explorer with local indexing and extensible event renderers.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/traces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/traces"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bb": ">=0.48.0 <1.0.0",
    "bbPluginSdk": ">=0.6.94"
  },
  "bb": {
    "name": "Traces",
    "description": "Explore Claude Code and Codex sessions, tool calls, context, and agent activity.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      },
      "experimental_icons": {
        "plugin": "./assets/icon.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "host": "./src/host/host.ts"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bb-plugins/ui": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/plugins-traces.tsbuildinfo",
    "test": "node --import ./test/preload-require.mjs --import tsx --test src/shared/providers/*.test.ts src/app/*.test.ts src/host/*.test.ts test/*.test.ts && bun test src/app/app.test.tsx",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./model": "./src/shared/model.ts",
    "./adapters": "./src/shared/providers/index.ts",
    "./renderers": "./src/app/renderers.tsx",
    "./app": "./src/app/app.tsx",
    "./host": "./src/host/host.ts"
  }
}
