{
  "name": "@smsunarto/bb-plugin-nanocodex",
  "version": "0.0.0",
  "description": "NanoCodex as a native bb provider through its JavaScript binding",
  "license": "MIT",
  "author": "Scott Sunarto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/nanocodex"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.40.0 <1.0.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Nanocodex",
    "description": "Runs native NanoCodex agents as persistent bb threads",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      },
      "experimental_icons": {
        "terminal": "./assets/terminal.svg"
      }
    },
    "server": "./server/server.ts",
    "host": "./host/host.ts",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/host.js",
    "dist/host.meta.json",
    "assets/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server/",
    "host/",
    "shared/"
  ],
  "dependencies": {
    "@bb-kit/core": "0.1.0",
    "@get-bb/plugin-sdk": "0.4.21",
    "nanocodex": "https://pkg.pr.new/nanocodex@fa3f254178fff43482476203bb4a007971ceed6b",
    "parallel-web": "^1.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {},
  "scripts": {
    "dev": "\"${BB_CLI:-bb}\" plugin dev .",
    "build": "bb plugin build .",
    "test": "bun test --timeout=30000",
    "typecheck": "tsc --noEmit",
    "check": "node --import tsx ../../packages/bb-kit-core/src/bin/bin.ts check"
  }
}
