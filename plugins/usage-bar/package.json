{
  "name": "@smsunarto/bb-plugin-usage-bar",
  "version": "0.1.0",
  "description": "CodexBar-style macOS menu bar meters for Codex and Claude quota, from Account Pooler or each CLI's signed-in account.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/usage-bar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/usage-bar"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.48.0 <1.0.0",
    "bbPluginSdk": ">=0.6.94"
  },
  "bb": {
    "name": "Usage Bar",
    "description": "Shows session, weekly, and per-model quota, limit reset credits, and extra usage for each Codex and Claude account in the macOS menu bar.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "host": "./src/host/host.ts"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/host.js",
    "dist/host.meta.json",
    "native/",
    "assets/",
    "README.md",
    "LICENSE",
    "src/"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.94",
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "clean": "rm -rf dist"
  }
}
