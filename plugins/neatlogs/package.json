{
  "name": "@smsunarto/bb-plugin-neatlogs",
  "version": "0.1.0",
  "description": "Export every completed BB agent turn, across providers, to Neatlogs as a nested trace.",
  "private": true,
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/neatlogs#readme",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/neatlogs"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "neatlogs",
    "observability",
    "tracing"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.48.0 <1.0.0",
    "bbPluginSdk": ">=0.6.94"
  },
  "bb": {
    "name": "Neatlogs",
    "description": "Export every completed BB agent turn to Neatlogs as a nested trace.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/*.js",
    "dist/*.json",
    "assets/",
    "skills/",
    "src/",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.94",
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "clean": "rm -rf dist"
  }
}
