{
  "name": "@smsunarto/bb-plugin-html",
  "version": "0.1.0",
  "description": "Agents publish interactive visualizations and HTML pages inline in the thread, following bb's theme.",
  "private": true,
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/html#readme",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/html"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.47.0 <1.0.0",
    "bbPluginSdk": ">=0.6.75"
  },
  "bb": {
    "name": "HTML visualizations",
    "description": "Agents publish interactive visualizations and HTML pages inline in the thread.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "html",
    "visualizations"
  ],
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "instructions/",
    "skills/",
    "src/",
    "vendor/video-player.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@bb-plugins/video-player": "workspace:*",
    "@bb-plugins/instructions": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bb-plugins/ui": "workspace:*",
    "@get-bb/plugin-sdk": "0.6.94",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@videojs/html": "10.1.0",
    "clsx": "^2.1.1",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "vendor:player": "bun vendor/build-video-player.ts",
    "clean": "rm -rf dist"
  }
}
