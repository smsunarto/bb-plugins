{
  "name": "@smsunarto/bb-plugin-html",
  "version": "0.1.0",
  "description": "Agents preview self-contained HTML pages in headless Chrome and show them inline in the thread, following bb's theme.",
  "private": true,
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/html#readme",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/html"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.47.0 <1.0.0",
    "bbPluginSdk": ">=0.6.75"
  },
  "bb": {
    "name": "HTML pages",
    "description": "Agents preview HTML pages in headless Chrome and show them inline in the thread.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "html"
  ],
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "instructions/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@bb-kit/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.75",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  }
}
