{
  "name": "@smsunarto/bb-plugin-remind-me",
  "version": "0.1.0",
  "private": true,
  "description": "Save deferred work from the current conversation with /remind-me.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "type": "module",
  "engines": {
    "bb": ">=0.47.0 <1.0.0",
    "bbPluginSdk": ">=0.6.75"
  },
  "bb": {
    "name": "Remind Me",
    "description": "Keep deferred work in a separate reminders list and add it to a composer when ready.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/",
    "assets/",
    "src/",
    "instructions/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@bb-kit/core": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@types/node": "^22.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.0",
    "tsx": "4.23.12"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/app --timeout=30000 && node --import tsx --test src/server/rpc/*.test.ts",
    "check": "bun ../../packages/bb-kit-dev/src/bin.ts check"
  }
}
