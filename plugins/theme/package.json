{
  "name": "bb-plugin-theme",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.36",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Theme",
    "description": "Ships Cursor Monokai as a selectable BB palette.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "themes": [
      {
        "id": "smsunarto",
        "name": "Cursor Monokai",
        "description": "Dark-only palette ported from the Cursor Monokai editor theme: one meaning per hue, the shared ANSI content palette, and Berkeley Mono.",
        "css": "./themes/smsunarto.css"
      }
    ],
    "skills": []
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^7.0.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "dev": "bun ../../scripts/dev-plugin.ts",
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  }
}
