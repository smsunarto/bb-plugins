{
  "name": "@smsunarto/bb-plugin-sauce",
  "version": "0.1.0",
  "description": "Drive Sauce Labs real devices from bb threads with the bb sauce command.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/sauce",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/sauce"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "sauce-labs",
    "real-device",
    "mobile-testing"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.48.1 <1.0.0",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Sauce Live",
    "description": "Drive Sauce Labs real devices from bb threads with the bb sauce command.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "assets/",
    "README.md",
    "LICENSE",
    "src/server/",
    "skills/",
    "instructions/"
  ],
  "dependencies": {
    "@bb-plugins/instructions": "workspace:*"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate --preload ./test/sqlite-preload.js src test --timeout=30000",
    "clean": "rm -rf dist"
  }
}
