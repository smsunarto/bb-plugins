{
  "name": "@smsunarto/bb-plugin-vimium",
  "version": "0.1.0",
  "description": "Vimium-style f-key link hints for keyboard navigation of the bb UI.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/vimium",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/vimium"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "vimium",
    "link-hints",
    "keyboard"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.40.0 <1.0.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Vimium",
    "description": "Press f to label every clickable element with a hint, then type the hint to click it.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server/server.ts",
    "app": "./app/app.tsx",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "assets/",
    "README.md",
    "LICENSE",
    "server/",
    "app/"
  ],
  "dependencies": {
    "@bb-kit/core": "0.1.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.34",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "25.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "dev": "\"${BB_CLI:-bb}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-core/src/bin/bin.ts check",
    "clean": "rm -rf dist"
  }
}
