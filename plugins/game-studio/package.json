{
  "name": "@smsunarto/bb-plugin-game-studio",
  "version": "0.1.0",
  "description": "Game Studio in BB: embeds the studio web app beside your threads, gives agents its API as tools, and runs Unity Editors and checkout slots on BB machines.",
  "license": "MIT AND Apache-2.0",
  "author": "Scott Sunarto",
  "type": "module",
  "private": true,
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "dist/host.js",
    "dist/host.meta.json",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src/server/",
    "src/app/",
    "src/host/",
    "src/shared/",
    "skills/",
    "instructions/"
  ],
  "engines": {
    "bb": ">=0.47.0",
    "bbPluginSdk": ">=0.6.75 <0.7"
  },
  "bb": {
    "name": "Game Studio",
    "description": "Design and build games with a canvas, your BB agents, and your game development tools.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ],
    "host": "./src/host/host.ts"
  },
  "dependencies": {
    "@bb-kit/core": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^12.0.0",
    "lucide-react": "1.57.0",
    "zod": "^4.4.3",
    "@argus-labs/game-studio-api": "link:@argus-labs/game-studio-api"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.75",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "test": "bun test --preload ./test/sqlite-preload.js src --timeout=30000",
    "clean": "rm -rf dist"
  }
}
