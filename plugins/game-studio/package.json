{
  "name": "@smsunarto/bb-plugin-game-studio",
  "version": "0.1.0",
  "description": "A native BB game studio adapted from OhMyGame, with a design canvas, assets, agent threads, and playable previews.",
  "license": "MIT AND Apache-2.0",
  "author": "Scott Sunarto",
  "type": "module",
  "private": true,
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "dist/host.js",
    "dist/host.meta.json",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src/server/",
    "src/app/",
    "src/host/",
    "src/shared/",
    "skills/",
    "instructions/"
  ],
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.5.29 <0.7"
  },
  "bb": {
    "name": "Game Studio",
    "description": "Design and build games with a canvas, your BB agents, and your game development tools.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ],
    "host": "./src/host/host.ts"
  },
  "dependencies": {
    "@bb-kit/core": "0.2.0",
    "@dagrejs/dagre": "3.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "12.11.3",
    "better-sqlite3": "^12.0.0",
    "lucide-react": "1.57.0",
    "three": "0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "bun-types": "^1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "build": "bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "test": "bun test --preload ./test/sqlite-preload.js src --timeout=30000",
    "clean": "rm -rf dist"
  }
}
