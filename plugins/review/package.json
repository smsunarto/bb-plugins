{
  "name": "@smsunarto/bb-plugin-review",
  "version": "0.1.0",
  "description": "Adversarial review of an agent's work by the other model family, in a hidden subthread with a composer banner.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/review",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/review"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bb": ">=0.44.0 <1.0.0",
    "bbPluginSdk": ">=0.5.26"
  },
  "bb": {
    "name": "Review",
    "description": "Agents ask the other model family to review their work before ending a turn. A banner shows the running review.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@bb-kit/core": "0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.4.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "\"${BB_CLI:?Run bun run dev from the repository root}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  }
}
