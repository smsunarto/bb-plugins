    "vitest.config.ts",
    "components",
    "hooks",
    "lib",
    "markdown-editor.tsx",
    "mdx-esm.tsx",
    "editor-styles.ts",
    "styles.d.ts",
    "canvas-editor.tsx",
    "markdown-editor.test.tsx"
  ]
}
