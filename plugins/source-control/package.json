{
  "name": "@smsunarto/bb-plugin-source-control",
  "version": "0.1.0",
  "private": true,
  "description": "One Change per branch: local checkout state and its GitHub pull request, read once and shown everywhere in bb.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/source-control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/source-control"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.49.0 <1.0.0",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Source Control",
    "description": "Each thread's branch and pull request as one Change: checkout state from its host, pull request state from GitHub.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "host": "./src/host/host.ts",
    "app": "./src/app/app.tsx"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "dist/*.map",
    "assets/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@testing-library/react": "16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.0",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist"
  }
}
