diff --git a/scripts/lib/browser.mjs b/scripts/lib/browser.mjs
--- /dev/null
+++ b/scripts/lib/browser.mjs
@@ -0,0 +1,102 @@
+import { spawnSync } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+export async function withBrowser(viewport, run) {
+  const session = `web-clone-${randomUUID()}`;
+
+  function command(args, { input, timeoutMs = 60_000 } = {}) {
+    const result = spawnSync("agent-browser", [
+      "--session", session, "--json", ...args.map(String),
+    ], {
+      encoding: "utf8",
+      input,
+      timeout: timeoutMs,
+      maxBuffer: 64 * 1024 * 1024,
+    });
+    if (result.error?.code === "ENOENT") {
+      throw new Error("agent-browser is required. Install it and run agent-browser install.");
+    }
+    if (result.error) throw result.error;
+
+    let response;
+    try {
+      response = JSON.parse(result.stdout);
+    } catch {
+      throw new Error(result.stderr.trim() || `agent-browser ${args[0]} returned invalid JSON`);
+    }
+    if (!response.success || result.status !== 0) {
+      throw new Error(response.error || `agent-browser ${args[0]} failed`);
+    }
+    return response.data;
+  }
+
+  const browser = {
+    command,
+    evaluate(fn, arg) {
+      const expression = `(${fn})(${JSON.stringify(arg) ?? ""})`;
+      return command(["eval", "--stdin"], { input: expression }).result;
+    },
+    screenshot(file) {
+      command(["screenshot", "--full", "--screenshot-format", "png", file]);
+    },
+    consoleMessages() {
+      return command(["console"]).messages;
+    },
+  };
+
+  let runError;
+  try {
+    const { width, height, scale = 1 } = viewport ?? { width: 1920, height: 1080, scale: 2 };
+    command(["set", "viewport", width, height, scale]);
+    return await run(browser);
+  } catch (error) {
+    runError = error;
+    throw error;
+  } finally {
+    try {
+      command(["close"], { timeoutMs: 10_000 });
+    } catch (error) {
+      if (!runError) throw error;
+    }
+  }
+}
+
+export async function navigate(browser, url, { idleMs = 0, waitMs = 0, timeoutMs = 45_000 } = {}) {
+  browser.command(["open", url], { timeoutMs });
+  if (idleMs > 0) {
+    try {
+      browser.command(["wait", "--load", "networkidle", "--timeout", idleMs], { timeoutMs: idleMs + 5_000 });
+    } catch {
+      // A busy page can still be captured.
+    }
+  }
+  if (waitMs > 0) browser.command(["wait", waitMs], { timeoutMs: waitMs + 5_000 });
+}
+
+// Keep the raw HAR temporary. Callers receive the structured traffic used by their report.
+export async function captureTraffic(browser, mode, run) {
+  const dir = mkdtempSync(join(tmpdir(), "web-clone-har-"));
+  try {
+    browser.command(["network", "har", "start", "--content", mode]);
+    const result = await run();
+    const file = join(dir, "traffic.har");
+    browser.command(["network", "har", "stop", file]);
+    const entries = JSON.parse(readFileSync(file, "utf8")).log.entries;
+    return { result, entries };
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+export function resourceType(entry) {
+  return (entry._resourceType || "other").toLowerCase();
+}
+
+export function responseBody(response) {
+  const { encoding, text } = response.content;
+  if (typeof text !== "string") return null;
+  return Buffer.from(text, encoding === "base64" ? "base64" : "utf8");
+}
