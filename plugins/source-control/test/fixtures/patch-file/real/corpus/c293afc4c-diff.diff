-// The hint code polls on chained timers, which drift when the whole suite runs
-// in parallel. Retry an assertion until it holds instead of racing a sleep.
+// The hint code polls on chained 60-80 ms timers. Every test runs on fake
+// timers, so those windows pass instantly and never drift under load.
+// setImmediate stays real, so it lets promise continuations run between steps.
+async function wait(ms: number): Promise<void> {
+  for (let elapsed = 0; elapsed < ms; elapsed += 10) {
+    jest.advanceTimersByTime(Math.min(10, ms - elapsed));
+    await new Promise((resolve) => setImmediate(resolve));
+  }
+}
+
+/** Retry an assertion until it holds, advancing the fake clock between tries. */
 async function eventually(assertion: () => void, timeoutMs = 2000): Promise<void> {
-  const deadline = Date.now() + timeoutMs;
-  for (;;) {
+  for (let elapsed = 0; ; elapsed += 20) {
     try {
       assertion();
       return;
     } catch (error) {
-      if (Date.now() > deadline) throw error;
-      await new Promise((resolve) => setTimeout(resolve, 20));
+      if (elapsed >= timeoutMs) throw error;
+      await wait(20);
     }
   }
 }
