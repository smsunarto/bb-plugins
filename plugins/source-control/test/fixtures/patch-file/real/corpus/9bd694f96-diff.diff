diff --git a/plugins/monokai/scripts/bb-monokai.template.css b/plugins/monokai/scripts/bb-monokai.template.css
index 42b564b92..a9a004c4e 100644
--- a/plugins/monokai/scripts/bb-monokai.template.css
+++ b/plugins/monokai/scripts/bb-monokai.template.css
@@ -1672,6 +1672,21 @@ diffs-container {
   margin-bottom: 8px;
 }
 
+/* The command palette (thread search) fills its input band and results with
+ * the page ground, a dialog's look on desktop. In the drawer that left the
+ * card's popover showing only above and below it, as lighter strips. Let the
+ * card show through, as bb's pickers and the composer's model sheet do. */
+.dark [data-persistent-drawer-content] [data-palette-input-band],
+.dark [data-persistent-drawer-content] [data-palette-results-clip] {
+  background: transparent;
+}
+
+/* Its dialog shadow drew a gray line across the drawer near the bottom in
+ * Light, where bb's shadow tokens are visible. */
+[data-persistent-drawer-content] > [data-testid="command-palette"] {
+  box-shadow: none;
+}
+
