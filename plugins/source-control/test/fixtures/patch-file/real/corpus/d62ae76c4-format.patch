From d62ae76c4e5f30058c83e2d8699ebe7e89e4ce35 Mon Sep 17 00:00:00 2001
From: Scott Sunarto <github@smsunarto.com>
Date: Sun, 15 Nov 2026 19:18:59 -0800
Subject: [PATCH] fix(source-control): outline section titles stay on one line,
 truncated

---
 plugins/source-control/src/app/page/guided-view.tsx | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/plugins/source-control/src/app/page/guided-view.tsx b/plugins/source-control/src/app/page/guided-view.tsx
index 53aac85b4..422acb720 100644
--- a/plugins/source-control/src/app/page/guided-view.tsx
+++ b/plugins/source-control/src/app/page/guided-view.tsx
@@ -581,6 +581,7 @@ const OutlineRow = memo(function OutlineRow({
         type="button"
         aria-current={current ? "location" : undefined}
         aria-expanded={expanded}
+        title={title}
         data-testid="sc-outline-row"
         data-group={id}
         onClick={() => (expanded ? onCollapse() : onExpand(id))}
@@ -601,7 +602,7 @@ const OutlineRow = memo(function OutlineRow({
         </span>
         <span
           className={cx(
-            "min-w-0 flex-1 text-[13px] leading-5",
+            "min-w-0 flex-1 truncate text-[13px] leading-5",
             current
               ? "font-semibold text-foreground"
               : done
-- 
2.56.0

