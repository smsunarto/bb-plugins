    "description": "Manage global and project instructions, skills, references, and plugin prompts.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      },
      "experimental_icons": {
        "plugin": "./assets/icon.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
