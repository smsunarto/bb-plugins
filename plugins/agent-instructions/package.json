    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "^5.101.4",
