{
  "name": "@smsunarto/bb-plugin-boat-sandbox",
  "version": "0.1.0",
  "description": "Run bb threads in on-demand Boat cloud sandboxes that stop when idle and resume from their saved disk.",
  "private": true,
  "license": "MIT",
  "author": "Scott Sunarto",
  "type": "module",
  "engines": {
    "bb": ">=0.48.0 <1.0.0",
    "bbPluginSdk": ">=0.6.94"
  },
  "bb": {
    "name": "Boat Sandbox [Experimental]",
    "description": "Run bb threads in on-demand Boat cloud sandboxes that stop when idle and resume from their saved disk.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "boat",
    "sandbox",
    "machine-provider"
  ],
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "skills/",
    "src/",
    "components/",
    "lib/",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.94",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.4.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist"
  }
}
