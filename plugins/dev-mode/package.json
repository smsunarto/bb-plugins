{
  "name": "@smsunarto/bb-plugin-scott-engineering",
  "version": "0.1.0",
  "description": "Arena, independent review, engineering skills, and shared principles for BB.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/dev-mode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/dev-mode"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.46.0 <1.0.0",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Dev Mode",
    "description": "Arena and independent review as injected prompts, plus engineering skills and shared principles.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "dist/*.json",
    "assets/",
    "instructions/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills/",
    "references/"
  ],
  "dependencies": {
    "@bb-kit/core": "workspace:*"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/server/server.test.ts src/server/command/principle.test.ts",
    "check": "node --import tsx ../../packages/bb-kit-dev/src/bin.ts check",
    "clean": "rm -rf dist"
  },
  "private": true
}
