{
  "name": "@smsunarto/bb-plugin-antigravity",
  "version": "0.1.0",
  "description": "First-class Google Antigravity provider for bb.",
  "keywords": [
    "bb",
    "bb-plugin",
    "antigravity",
    "agy",
    "google",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/antigravity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/antigravity"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.48.0 <1.0.0",
    "bbPluginSdk": ">=0.6.150"
  },
  "bb": {
    "name": "Antigravity",
    "description": "First-class Google Antigravity provider for bb with Auto and Plan modes, /compact, immediate model reasoning discovery, quota reporting, CLI install/update, and native skill/plugin roots.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "host": "./src/host/host.ts",
    "skills": [
      "./skills/*"
    ]
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/host.js",
    "dist/host.meta.json",
    "assets/",
    "skills/",
    "src/",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/plugins-antigravity.tsbuildinfo",
    "test": "node --test --import ../../scripts/test-tmp-root-preload.mjs --import tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  }
}
