diff --git a/Assets/Rampage/_Scenes/Gameplay/Scripts/Network/ServerTickClock.cs b/Assets/Rampage/_Scenes/Gameplay/Scripts/Network/ServerTickClock.cs
new file mode 100644
index 000000000..a1db9d7e8
--- /dev/null
+++ b/Assets/Rampage/_Scenes/Gameplay/Scripts/Network/ServerTickClock.cs
@@ -0,0 +1,402 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace ArgusLabs.Rampage.Client.Gameplay.Network
+{
+    /// <summary>
+    /// Tracks authoritative server time using a monotonic local clock.
+    /// </summary>
+    public sealed class ServerTickClock
+    {
+        private readonly object _sync = new object();
+
+        private bool _isConfigured;
+        private double _fixedStepSeconds;
+        private double _maxExtrapolationSeconds;
+        private bool _hasServerTick;
+        private ulong _latestServerTick;
+        private long _latestReceiptTimestamp;
+        private double _smoothedRttSeconds;
+        private bool _isGameplayPaused;
+        private ulong _pauseStartTick;
+        private bool _hasPendingResumeTick;
+        private ulong _pendingResumeTick;
+        private readonly List<PauseInterval> _completedPauses = new List<PauseInterval>();
+
+        public ServerTickClock()
+        {
+        }
+
+        public ServerTickClock(double fixedStepSeconds, double maxExtrapolationSeconds)
+        {
+            Configure(fixedStepSeconds, maxExtrapolationSeconds);
+        }
+
+        public bool IsConfigured
+        {
+            get
+            {
+                lock (_sync)
+                {
+                    return _isConfigured;
+                }
+            }
+        }
+
+        public bool HasServerTick
+        {
+            get
+            {
+                lock (_sync)
+                {
+                    return _hasServerTick;
+                }
+            }
+        }
+
+        public ulong LatestServerTick
+        {
+            get
+            {
+                lock (_sync)
+                {
+                    return _latestServerTick;
+                }
+            }
+        }
+
+        public double SmoothedRttSeconds
+        {
+            get
+            {
+                lock (_sync)
+                {
+                    return _smoothedRttSeconds;
+                }
+            }
+        }
+
+        public bool IsGameplayPaused
+        {
+            get
+            {
+                lock (_sync)
+                {
+                    return _isGameplayPaused;
+                }
+            }
+        }
+
+        public void Configure(double fixedStepSeconds, double maxExtrapolationSeconds)
+        {
+            ValidatePositiveFinite(fixedStepSeconds, nameof(fixedStepSeconds));
+            ValidateNonNegativeFinite(maxExtrapolationSeconds, nameof(maxExtrapolationSeconds));
+
+            lock (_sync)
+            {
+                _fixedStepSeconds = fixedStepSeconds;
+                _maxExtrapolationSeconds = maxExtrapolationSeconds;
+                _isConfigured = true;
+            }
+        }
+
+        public bool ObserveServerTick(ulong serverTick)
+        {
+            return ObserveServerTick(serverTick, Stopwatch.GetTimestamp());
+        }
+
+        public bool ObserveServerTick(ulong serverTick, long receiptTimestamp)
+        {
+            lock (_sync)
+            {
+                return ObserveServerTickLocked(serverTick, receiptTimestamp, false);
+            }
+        }
+
+        public bool PauseGameplay(ulong serverTick)
+        {
+            return PauseGameplay(serverTick, Stopwatch.GetTimestamp());
+        }
+
+        public bool PauseGameplay(ulong serverTick, long receiptTimestamp)
+        {
+            lock (_sync)
+            {
+                AnchorServerTickLocked(serverTick, receiptTimestamp);
+                if (_isGameplayPaused)
+                {
+                    return false;
+                }
+                if (ContainsPauseStartLocked(serverTick))
+                {
+                    return false;
+                }
+                if (_hasPendingResumeTick)
+                {
+                    if (_pendingResumeTick >= serverTick)
+                    {
+                        AddPauseIntervalLocked(serverTick, _pendingResumeTick);
+                        _hasPendingResumeTick = false;
+                        return false;
+                    }
+                    _hasPendingResumeTick = false;
+                }
+
+                _pauseStartTick = serverTick;
+                _isGameplayPaused = true;
+                return true;
+            }
+        }
+
+        public bool ResumeGameplay(ulong serverTick)
+        {
+            return ResumeGameplay(serverTick, Stopwatch.GetTimestamp());
+        }
+
+        public bool ResumeGameplay(ulong serverTick, long receiptTimestamp)
+        {
+            lock (_sync)
+            {
+                AnchorServerTickLocked(serverTick, receiptTimestamp);
+                if (!_isGameplayPaused)
+                {
+                    if (!_hasPendingResumeTick || serverTick > _pendingResumeTick)
+                    {
+                        _pendingResumeTick = serverTick;
+                        _hasPendingResumeTick = true;
+                    }
+                    return false;
+                }
+                if (serverTick < _pauseStartTick)
+                {
+                    return false;
+                }
+
+                if (serverTick > _pauseStartTick)
+                {
+                    AddPauseIntervalLocked(_pauseStartTick, serverTick);
+                }
+
+                _pauseStartTick = 0;
+                _isGameplayPaused = false;
+                _hasPendingResumeTick = false;
+                return true;
+            }
+        }
+
+        public void ObserveSmoothedRttSeconds(double smoothedRttSeconds)
+        {
+            ValidateNonNegativeFinite(smoothedRttSeconds, nameof(smoothedRttSeconds));
+
+            lock (_sync)
+            {
+                _smoothedRttSeconds = smoothedRttSeconds;
+            }
+        }
+
+        public double EstimateServerTick()
+        {
+            return EstimateServerTick(Stopwatch.GetTimestamp(), Stopwatch.Frequency);
+        }
+
+        public double EstimateServerTick(long monotonicTimestamp, long timestampFrequency)
+        {
+            ValidateTimestampFrequency(timestampFrequency);
+
+            lock (_sync)
+            {
+                if (!_hasServerTick)
+                {
+                    return 0d;
+                }
+
+                if (!_isConfigured)
+                {
+                    return _latestServerTick;
+                }
+
+                if (_isGameplayPaused)
+                {
+                    return _pauseStartTick;
+                }
+
+                double extrapolatedSeconds = CalculateExtrapolatedSeconds(
+                    monotonicTimestamp,
+                    timestampFrequency);
+                return _latestServerTick + extrapolatedSeconds / _fixedStepSeconds;
+            }
+        }
+
+        public double GetElapsedSeconds(
+            ulong phaseOriginTick,
+            double? lifetimeSeconds = null)
+        {
+            return GetElapsedSeconds(
+                phaseOriginTick,
+                Stopwatch.GetTimestamp(),
+                Stopwatch.Frequency,
+                lifetimeSeconds);
+        }
+
+        public double GetElapsedSeconds(
+            ulong phaseOriginTick,
+            long monotonicTimestamp,
+            long timestampFrequency,
+            double? lifetimeSeconds = null)
+        {
+            ValidateTimestampFrequency(timestampFrequency);
+            if (lifetimeSeconds.HasValue)
+            {
+                ValidateNonNegativeFinite(lifetimeSeconds.Value, nameof(lifetimeSeconds));
+            }
+
+            lock (_sync)
+            {
+                if (!_hasServerTick || !_isConfigured)
+                {
+                    return 0d;
+                }
+
+                double estimatedTick = _isGameplayPaused
+                    ? _pauseStartTick
+                    : _latestServerTick + CalculateExtrapolatedSeconds(
+                        monotonicTimestamp,
+                        timestampFrequency) / _fixedStepSeconds;
+                double elapsedTicks = estimatedTick - phaseOriginTick;
+                if (elapsedTicks > 0d)
+                {
+                    elapsedTicks -= CountPausedTicks(phaseOriginTick, estimatedTick);
+                }
+                double elapsedSeconds = Math.Max(0d, elapsedTicks * _fixedStepSeconds);
+
+                return lifetimeSeconds.HasValue
+                    ? Math.Min(elapsedSeconds, lifetimeSeconds.Value)
+                    : elapsedSeconds;
+            }
+        }
+
+        private bool ObserveServerTickLocked(
+            ulong serverTick,
+            long receiptTimestamp,
+            bool refreshEqualTickReceipt)
+        {
+            if (_hasServerTick && serverTick < _latestServerTick)
+            {
+                return false;
+            }
+            if (_hasServerTick && serverTick == _latestServerTick)
+            {
+                if (refreshEqualTickReceipt)
+                {
+                    _latestReceiptTimestamp = receiptTimestamp;
+                }
+                return false;
+            }
+
+            _latestServerTick = serverTick;
+            _latestReceiptTimestamp = receiptTimestamp;
+            _hasServerTick = true;
+            return true;
+        }
+
+        private void AnchorServerTickLocked(ulong serverTick, long receiptTimestamp)
+        {
+            ObserveServerTickLocked(serverTick, receiptTimestamp, true);
+        }
+
+        private bool ContainsPauseStartLocked(ulong pauseStartTick)
+        {
+            foreach (PauseInterval pause in _completedPauses)
+            {
+                if (pause.StartTick == pauseStartTick)
+                {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private void AddPauseIntervalLocked(ulong startTick, ulong endTick)
+        {
+            if (endTick <= startTick || ContainsPauseStartLocked(startTick))
+            {
+                return;
+            }
+            _completedPauses.Add(new PauseInterval(startTick, endTick));
+        }
+
+        private double CountPausedTicks(ulong phaseOriginTick, double estimatedTick)
+        {
+            double pausedTicks = 0d;
+            foreach (PauseInterval pause in _completedPauses)
+            {
+                double overlapStart = Math.Max(phaseOriginTick, pause.StartTick);
+                double overlapEnd = Math.Min(estimatedTick, pause.EndTick);
+                if (overlapEnd > overlapStart)
+                {
+                    pausedTicks += overlapEnd - overlapStart;
+                }
+            }
+            return pausedTicks;
+        }
+
+        private double CalculateExtrapolatedSeconds(
+            long monotonicTimestamp,
+            long timestampFrequency)
+        {
+            double monotonicElapsedSeconds =
+                (monotonicTimestamp - _latestReceiptTimestamp) / (double)timestampFrequency;
+            double extrapolatedSeconds = monotonicElapsedSeconds + _smoothedRttSeconds * 0.5d;
+
+            return Math.Min(
+                Math.Max(extrapolatedSeconds, 0d),
+                _maxExtrapolationSeconds);
+        }
+
+        private static void ValidateTimestampFrequency(long timestampFrequency)
+        {
+            if (timestampFrequency <= 0)
+            {
+                throw new ArgumentOutOfRangeException(
+                    nameof(timestampFrequency),
+                    timestampFrequency,
+                    "Timestamp frequency must be positive.");
+            }
+        }
+
+        private static void ValidatePositiveFinite(double value, string parameterName)
+        {
+            if (value <= 0d || double.IsNaN(value) || double.IsInfinity(value))
+            {
+                throw new ArgumentOutOfRangeException(
+                    parameterName,
+                    value,
+                    "Value must be positive and finite.");
+            }
+        }
+
+        private static void ValidateNonNegativeFinite(double value, string parameterName)
+        {
+            if (value < 0d || double.IsNaN(value) || double.IsInfinity(value))
+            {
+                throw new ArgumentOutOfRangeException(
+                    parameterName,
+                    value,
+                    "Value must be non-negative and finite.");
+            }
+        }
+
+        private readonly struct PauseInterval
+        {
+            public PauseInterval(ulong startTick, ulong endTick)
+            {
+                StartTick = startTick;
+                EndTick = endTick;
+            }
+
+            public ulong StartTick { get; }
+            public ulong EndTick { get; }
+        }
+    }
+}
