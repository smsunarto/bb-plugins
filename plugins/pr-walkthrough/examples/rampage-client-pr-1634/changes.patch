+using ArgusLabs.Rampage.Client.Gameplay.Network;
+using NUnit.Framework;
+
+namespace ArgusLabs.Rampage.Client.Tests.EditMode
+{
+    public class ServerTickClockTests
+    {
+        private const long TimestampFrequency = 1_000;
+
+        [Test]
+        public void StaleServerTickDoesNotReplaceLatestObservation()
+        {
+            var clock = new ServerTickClock();
+            clock.Configure(0.1d, 2d);
+
+            Assert.That(clock.ObserveServerTick(10, 100), Is.True);
+            Assert.That(clock.ObserveServerTick(9, 1_000), Is.False);
+            Assert.That(clock.ObserveServerTick(10, 1_000), Is.False);
+
+            Assert.That(clock.LatestServerTick, Is.EqualTo(10));
+            Assert.That(
+                clock.EstimateServerTick(1_100, TimestampFrequency),
+                Is.EqualTo(20d).Within(1e-9d));
+        }
+
+        [Test]
+        public void EstimateIncludesHalfOfSmoothedRtt()
+        {
+            var clock = new ServerTickClock(0.1d, 1d);
+            clock.ObserveServerTick(20, 1_000);
+            clock.ObserveSmoothedRttSeconds(0.2d);
+
+            Assert.That(
+                clock.EstimateServerTick(1_000, TimestampFrequency),
+                Is.EqualTo(21d).Within(1e-9d));
+        }
+
+        [Test]
+        public void EstimateClampsExtrapolation()
+        {
+            var clock = new ServerTickClock(0.05d, 0.2d);
+            clock.ObserveServerTick(50, 1_000);
+
+            Assert.That(
+                clock.EstimateServerTick(5_000, TimestampFrequency),
+                Is.EqualTo(54d).Within(1e-9d));
+        }
+
+        [Test]
+        public void ElapsedPhaseClampsToZeroAndLifetime()
+        {
+            var clock = new ServerTickClock(0.1d, 1d);
+            clock.ObserveServerTick(100, 1_000);
+
+            Assert.That(
+                clock.GetElapsedSeconds(102, 1_500, TimestampFrequency),
+                Is.EqualTo(0.3d).Within(1e-9d));
+            Assert.That(
+                clock.GetElapsedSeconds(102, 1_500, TimestampFrequency, 0.25d),
+                Is.EqualTo(0.25d).Within(1e-9d));
+            Assert.That(
+                clock.GetElapsedSeconds(106, 1_500, TimestampFrequency),
+                Is.Zero);
+        }
+
+        [Test]
+        public void PauseFreezesEstimatesAndElapsedPhaseTime()
+        {
+            var clock = new ServerTickClock(0.1d, 1d);
+            clock.ObserveServerTick(100, 1_000);
+
+            Assert.That(clock.PauseGameplay(102, 1_200), Is.True);
+            Assert.That(
+                clock.EstimateServerTick(5_000, TimestampFrequency),
+                Is.EqualTo(102d).Within(1e-9d));
+            Assert.That(
+                clock.GetElapsedSeconds(90, 5_000, TimestampFrequency),
+                Is.EqualTo(1.2d).Within(1e-9d));
+        }
+
+        [Test]
+        public void ElapsedPhaseExcludesCompletedPauseTicks()
+        {
+            var clock = new ServerTickClock(0.1d, 1d);
+            clock.ObserveServerTick(100, 1_000);
+            clock.PauseGameplay(102, 1_200);
+
+            Assert.That(clock.ResumeGameplay(202, 5_000), Is.True);
+            Assert.That(
+                clock.GetElapsedSeconds(90, 5_000, TimestampFrequency),
+                Is.EqualTo(1.2d).Within(1e-9d));
+            Assert.That(
+                clock.GetElapsedSeconds(150, 5_000, TimestampFrequency),
+                Is.Zero);
+            Assert.That(
+                clock.GetElapsedSeconds(90, 5_500, TimestampFrequency),
+                Is.EqualTo(1.7d).Within(1e-9d));
+        }
+
+        [Test]
+        public void DuplicatePauseBoundariesAreIgnored()
+        {
+            var clock = new ServerTickClock(0.1d, 1d);
+
+            Assert.That(clock.PauseGameplay(10, 1_000), Is.True);
+            Assert.That(clock.PauseGameplay(11, 1_100), Is.False);
+            Assert.That(clock.ResumeGameplay(20, 2_000), Is.True);
+            Assert.That(clock.ResumeGameplay(21, 2_100), Is.False);
+            Assert.That(
+                clock.GetElapsedSeconds(5, 2_100, TimestampFrequency),
+                Is.EqualTo(0.6d).Within(1e-9d));
+        }
+
+        [Test]
+        public void ResumeDeliveredBeforePauseStillRecordsOneInterval()
+        {
+            var clock = new ServerTickClock(0.1d, 1d);
+            clock.ObserveServerTick(100, 1_000);
+
+            Assert.That(clock.ResumeGameplay(202, 5_000), Is.False);
+            Assert.That(clock.PauseGameplay(102, 5_100), Is.False);
+            Assert.That(clock.IsGameplayPaused, Is.False);
+            Assert.That(
+                clock.GetElapsedSeconds(90, 5_000, TimestampFrequency),
+                Is.EqualTo(1.2d).Within(1e-9d));
+        }
+    }
+}
