+
+        public void Start(float currentTime, bool paused)
+        {
+            _isStarted = true;
+            _isPaused = paused;
+            _startTime = currentTime;
+            _pauseStartedAt = paused ? currentTime : 0f;
+        }
+
+        public void Pause(float currentTime)
+        {
+            if (!_isStarted || _isPaused)
+            {
+                return;
+            }
+
+            _isPaused = true;
+            _pauseStartedAt = currentTime;
+        }
+
+        public void Resume(float currentTime)
+        {
+            if (!_isStarted || !_isPaused)
+            {
+                return;
+            }
+
+            float pausedSeconds = currentTime - _pauseStartedAt;
+            if (pausedSeconds > 0f)
+            {
+                _startTime += pausedSeconds;
+            }
+            _isPaused = false;
+            _pauseStartedAt = 0f;
+        }
+
+        public float GetElapsed(float currentTime)
+        {
+            if (!_isStarted)
+            {
+                return 0f;
+            }
+
+            float effectiveCurrentTime = _isPaused ? _pauseStartedAt : currentTime;
+            float elapsed = effectiveCurrentTime - _startTime;
+            return elapsed > 0f ? elapsed : 0f;
+        }
