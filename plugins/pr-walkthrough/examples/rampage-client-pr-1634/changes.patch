+using ArgusLabs.Rampage.Client._Scenes.Gameplay.Objects.Players.Scripts.Controllers;
+using NUnit.Framework;
+
+namespace ArgusLabs.Rampage.Client.Tests.EditMode
+{
+    public class MovementSettingsTests
+    {
+        [Test]
+        public void EffectiveMoveSpeedRejectsOlderServerTick()
+        {
+            var state = new EffectiveMoveSpeedState();
+
+            Assert.That(state.TryApply(7.5f, 20), Is.True);
+            Assert.That(state.TryApply(3f, 19), Is.False);
+            Assert.That(state.Value, Is.EqualTo(7.5f));
+        }
+
+        [Test]
+        public void EffectiveMoveSpeedRejectsInvalidValues()
+        {
+            var state = new EffectiveMoveSpeedState();
+
+            Assert.That(state.TryApply(0f, 1), Is.False);
+            Assert.That(state.TryApply(float.NaN, 1), Is.False);
+            Assert.That(state.TryApply(float.PositiveInfinity, 1), Is.False);
+        }
+
+        [Test]
+        public void ResetAllowsNewSessionToStartAtLowerTick()
+        {
+            var state = new EffectiveMoveSpeedState();
+            Assert.That(state.TryApply(7f, 100), Is.True);
+            state.Reset();
+
+            Assert.That(state.TryApply(5f, 1), Is.True);
+            Assert.That(state.Value, Is.EqualTo(5f));
+        }
+    }
+}
