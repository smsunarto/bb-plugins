@@ -0,0 +1,76 @@
+using NUnit.Framework;
+using Rampage.Gameplay;
+using UnityEngine;
+
+namespace ArgusLabs.Rampage.Client.Tests
+{
+    public class DashKinematicsConsumerTests
+    {
+        [Test]
+        public void SharedPlanMapsVelocityAndRawTargetToUnityXZ()
+        {
+            var input = new DashPlanInput(
+                2,
+                -3,
+                3,
+                4,
+                -1,
+                0,
+                10);
+            DashPlanResult shared = DashKinematics.Plan(in input);
+
+            var unityDirection = new Vector3(
+                shared.DirectionX,
+                0f,
+                shared.DirectionZ);
+            var unityTarget = new Vector3(
+                (float)shared.RawTargetX,
+                0f,
+                (float)shared.RawTargetZ);
+
+            Assert.That(unityDirection, Is.EqualTo(new Vector3(0.6f, 0f, 0.8f)));
+            Assert.That(unityTarget, Is.EqualTo(new Vector3(8f, 0f, 5f)));
+        }
+
+        [Test]
+        public void SharedPlanUsesPositiveXWhenVelocityAndFacingAreZero()
+        {
+            var input = new DashPlanInput(
+                2,
+                -3,
+                0,
+                0,
+                0,
+                0,
+                6);
+            DashPlanResult shared = DashKinematics.Plan(in input);
+
+            Assert.That(shared.DirectionX, Is.EqualTo(1f));
+            Assert.That(shared.DirectionZ, Is.EqualTo(0f));
+            Assert.That(shared.RawTargetX, Is.EqualTo(8d));
+            Assert.That(shared.RawTargetZ, Is.EqualTo(-3d));
+        }
+
+        [Test]
+        public void SharedSampleMapsProgressAndPositionToUnityXZ()
+        {
+            var input = new DashSampleInput(
+                2,
+                -3,
+                8,
+                5,
+                0.25f,
+                0.5f);
+            DashSampleResult shared = DashKinematics.Sample(in input);
+
+            var unityPosition = new Vector3(
+                (float)shared.PositionX,
+                0f,
+                (float)shared.PositionZ);
+
+            Assert.That(shared.Progress, Is.EqualTo(0.5f));
+            Assert.That(shared.Complete, Is.False);
+            Assert.That(unityPosition, Is.EqualTo(new Vector3(5f, 0f, 1f)));
+        }
+    }
+}
