+using ArgusLabs.Rampage.Client._Scenes.Gameplay.Objects.Players.Scripts.Controllers;
+using NUnit.Framework;
+
+namespace ArgusLabs.Rampage.Client.Tests.EditMode
+{
+    public class PauseAwareElapsedTimerTests
+    {
+        [Test]
+        public void PauseWindowDoesNotAdvanceElapsedTime()
+        {
+            var timer = new PauseAwareElapsedTimer();
+            timer.Start(10f, false);
+
+            timer.Pause(10.2f);
+            Assert.That(timer.GetElapsed(15f), Is.EqualTo(0.2f).Within(0.0001f));
+
+            timer.Resume(15f);
+            Assert.That(timer.GetElapsed(15.3f), Is.EqualTo(0.5f).Within(0.0001f));
+        }
+
+        [Test]
+        public void TimerStartedDuringPauseBeginsAtResume()
+        {
+            var timer = new PauseAwareElapsedTimer();
+            timer.Start(20f, true);
+
+            Assert.That(timer.GetElapsed(24f), Is.Zero);
+            timer.Resume(24f);
+            Assert.That(timer.GetElapsed(24.25f), Is.EqualTo(0.25f).Within(0.0001f));
+        }
+
+        [Test]
+        public void DuplicatePauseAndResumeCallsAreIdempotent()
+        {
+            var timer = new PauseAwareElapsedTimer();
+            timer.Start(1f, false);
+
+            timer.Pause(2f);
+            timer.Pause(3f);
+            timer.Resume(5f);
+            timer.Resume(6f);
+
+            Assert.That(timer.GetElapsed(6f), Is.EqualTo(2f).Within(0.0001f));
+        }
+    }
+}
