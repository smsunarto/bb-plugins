{
  "name": "@smsunarto/bb-plugin-bots",
  "version": "0.1.0",
  "description": "Named bots with private instructions and memory, each with its own conversations.",
  "private": true,
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/bots#readme",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/bots"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "bots",
    "agents"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.48.1 <1.0.0",
    "bbPluginSdk": ">=0.6.104"
  },
  "bbPluginBuild": {
    "experimental_cssScope": "owned-root-v1"
  },
  "bb": {
    "name": "Bots",
    "description": "Named bots with private instructions and memory. GTD Sidebar shows them on its Bots shelf.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "exports": {
    "./shelf": "./shelf.ts",
    "./bots.css": "./bots.css"
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "dist/app.owned-root.css",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.ts",
    "app.tsx",
    "shelf.ts",
    "contract.ts",
    "bots.css",
    "components/",
    "hooks/",
    "lib/",
    "skills/",
    "instructions/",
    "types/"
  ],
  "dependencies": {
    "@bb-plugins/instructions": "workspace:*",
    "@bb-plugins/ui": "workspace:*",
    "@get-bb/plugin-sdk": "0.6.132",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "radix-ui": "^1.8.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.0",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "bundledDependencies": [
    "@bb-plugins/instructions",
    "@bb-plugins/ui"
  ]
}
