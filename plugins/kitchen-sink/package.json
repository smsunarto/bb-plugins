{
  "name": "@smsunarto/bb-plugin-kitchen-sink",
  "version": "0.1.0",
  "description": "Scott's kitchen sink of personal composer commands and mentions: ship-it and sync skills, plus a home for mention providers.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/kitchen-sink",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/kitchen-sink"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "skills",
    "gitbutler",
    "ship-it",
    "sync"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.41.0 <1.0.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Kitchen Sink",
    "description": "Personal composer commands and mentions: /ship-it runs the CI gates and lands or opens a PR, /sync rebases and resolves conflicts.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server/server.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "assets/",
    "README.md",
    "LICENSE",
    "server/",
    "skills/"
  ],
  "dependencies": {
    "@bb-kit/core": "0.1.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.34",
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "\"${BB_CLI:?Run bun run dev from the repository root}\" plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "check": "node --import tsx ../../packages/bb-kit-core/src/bin/bin.ts check",
    "clean": "rm -rf dist"
  }
}
