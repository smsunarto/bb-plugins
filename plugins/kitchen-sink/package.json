{
  "name": "@smsunarto/bb-plugin-kitchen-sink",
  "version": "0.1.0",
  "description": "Scott's kitchen sink of personal bb surfaces: composer commands, provider branding, and Smart Embeds.",
  "license": "MIT",
  "author": "Scott Sunarto",
  "homepage": "https://github.com/smsunarto/bb-plugins/tree/main/plugins/kitchen-sink",
  "bugs": {
    "url": "https://github.com/smsunarto/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smsunarto/bb-plugins.git",
    "directory": "plugins/kitchen-sink"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "skills",
    "gitbutler",
    "ship-it",
    "sync",
    "rich-embeds",
    "code-citations"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.48.0 <1.0.0",
    "bbPluginSdk": ">=0.6.75"
  },
  "bb": {
    "name": "Kitchen Sink",
    "description": "Personal bb surfaces: composer workflows, provider branding, and Smart Embeds.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./src/server/server.ts",
    "app": "./src/app/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "assets/",
    "README.md",
    "LICENSE",
    "src/server/",
    "src/app/",
    "src/shared/",
    "skills/",
    "instructions/"
  ],
  "dependencies": {
    "@bb-plugins/instructions": "workspace:*",
    "@bb-plugins/unity-inspector": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "lenis": "1.3.26",
    "react-compare-slider": "4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bb-plugins/testing": "workspace:*",
    "@get-bb/plugin-sdk": "0.6.75",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bun-types": "^1.4.0",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^1.7.4",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test/sqlite-preload.js src test eval/score.test.ts --timeout=30000",
    "clean": "rm -rf dist"
  }
}
