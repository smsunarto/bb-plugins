{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "import", "promise", "react", "jsx-a11y"],
  "jsPlugins": ["oxlint-plugin-complexity"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/generated/**",
    "**/*.d.ts"
  ],
  "rules": {
    "complexity/complexity": [
      "warn",
      {
        "cyclomatic": 18,
        "cognitive": 20
      }
    ],
    "no-console": "off",
    "typescript/no-explicit-any": "off",
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "warn",
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off",
    "no-shadow": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "import/no-unassigned-import": "off",
    "unicorn/prefer-node-protocol": "error",
    "import/no-duplicates": "error",
    "promise/no-return-wrap": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "require-yield": "off"
      }
    },
    {
      "files": ["plugins/scott-docs/components/ui/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["plugins/scott-tasks/**"],
      "rules": {
        "no-control-regex": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "oxc/no-map-spread": "off",
        "typescript/no-non-null-asserted-optional-chain": "off",
        "unicorn/no-new-array": "off"
      }
    },
    {
      "files": [
        "plugins/genui/components/ui/responsive-overlay.tsx",
        "plugins/genui/core/answers.ts",
        "plugins/genui/core/benchmark.ts",
        "plugins/genui/core/compare.ts",
        "plugins/genui/core/decisions.ts",
        "plugins/genui/core/environments.ts",
        "plugins/genui/core/language.test.ts",
        "plugins/genui/core/logs.ts",
        "plugins/genui/core/markdown.ts",
        "plugins/genui/core/parser.ts",
        "plugins/genui/core/pipeline.ts",
        "plugins/genui/core/source.ts",
        "plugins/genui/core/stack-trace.ts",
        "plugins/genui/core/streaming.test.ts",
        "plugins/genui/core/streaming.ts",
        "plugins/genui/core/test-results.ts",
        "plugins/genui/core/tracking.ts",
        "plugins/genui/core/transcript.test.ts",
        "plugins/genui/core/transcript.ts",
        "plugins/genui/core/treemap.test.ts",
        "plugins/genui/gallery/data/src/json-logic.ts",
        "plugins/genui/gallery/data/src/mapMath.ts",
        "plugins/genui/project/environments.ts",
        "plugins/genui/project/source.test.ts",
        "plugins/genui/scripts/scroll-jitter.mjs",
        "plugins/genui/ui/AppBlock.tsx",
        "plugins/genui/ui/Fence.test.tsx",
        "plugins/genui/ui/Fence.tsx",
        "plugins/genui/ui/FenceOverlay.tsx",
        "plugins/genui/ui/FrameFooter.tsx",
        "plugins/genui/ui/GalleryHeader.tsx",
        "plugins/genui/ui/GalleryPanel.tsx",
        "plugins/genui/ui/LiveUi.tsx",
        "plugins/genui/ui/UiDirective.tsx",
        "plugins/genui/ui/answerSheet.ts",
        "plugins/genui/ui/answers.test.tsx",
        "plugins/genui/ui/appDocument.ts",
        "plugins/genui/ui/codeHeight.ts",
        "plugins/genui/ui/components/Acceptance.tsx",
        "plugins/genui/ui/components/Benchmark.tsx",
        "plugins/genui/ui/components/CalendarHeatmap.tsx",
        "plugins/genui/ui/components/Chart.tsx",
        "plugins/genui/ui/components/Compare.tsx",
        "plugins/genui/ui/components/Coverage.tsx",
        "plugins/genui/ui/components/Dependencies.tsx",
        "plugins/genui/ui/components/EditableTable.tsx",
        "plugins/genui/ui/components/Findings.tsx",
        "plugins/genui/ui/components/Json.tsx",
        "plugins/genui/ui/components/Logs.tsx",
        "plugins/genui/ui/components/Map.tsx",
        "plugins/genui/ui/components/Pipeline.tsx",
        "plugins/genui/ui/components/Provenance.tsx",
        "plugins/genui/ui/components/Scene.tsx",
        "plugins/genui/ui/components/Tests.tsx",
        "plugins/genui/ui/components/Transcript.tsx",
        "plugins/genui/ui/components/Treemap.tsx",
        "plugins/genui/ui/components/Waterfall.tsx",
        "plugins/genui/ui/components/changes.tsx",
        "plugins/genui/ui/components/chartKit.tsx",
        "plugins/genui/ui/components/chartMath.ts",
        "plugins/genui/ui/components/chartTypes.tsx",
        "plugins/genui/ui/components/choose.tsx",
        "plugins/genui/ui/components/code.tsx",
        "plugins/genui/ui/components/codeHealthKit.tsx",
        "plugins/genui/ui/components/commits.tsx",
        "plugins/genui/ui/components/content.tsx",
        "plugins/genui/ui/components/decisions.tsx",
        "plugins/genui/ui/components/diagram.tsx",
        "plugins/genui/ui/components/display.tsx",
        "plugins/genui/ui/components/environments.tsx",
        "plugins/genui/ui/components/explain.tsx",
        "plugins/genui/ui/components/fields.tsx",
        "plugins/genui/ui/components/form.tsx",
        "plugins/genui/ui/components/gpu.ts",
        "plugins/genui/ui/components/inputs.tsx",
        "plugins/genui/ui/components/layout.tsx",
        "plugins/genui/ui/components/media.tsx",
        "plugins/genui/ui/components/meters.tsx",
        "plugins/genui/ui/components/motion.ts",
        "plugins/genui/ui/components/perfKit.tsx",
        "plugins/genui/ui/components/projectKit.tsx",
        "plugins/genui/ui/components/pullRequest.tsx",
        "plugins/genui/ui/components/references.tsx",
        "plugins/genui/ui/components/sceneMath.test.ts",
        "plugins/genui/ui/components/threads.tsx",
        "plugins/genui/ui/components/tracking.tsx",
        "plugins/genui/ui/components/viewer.tsx",
        "plugins/genui/ui/components/webMedia.tsx",
        "plugins/genui/ui/components/widgets.tsx",
        "plugins/genui/ui/paneBounds.ts",
        "plugins/genui/ui/render.tsx",
        "plugins/genui/ui/reservedHeight.ts",
        "plugins/genui/ui/sketchFont.ts",
        "plugins/genui/ui/theme.ts",
        "plugins/genui/ui/useLoadedData.ts",
        "plugins/genui/ui/useSuperseded.ts",
        "plugins/genui/web/commons.ts"
      ],
      "rules": {
        "jsx-a11y/aria-role": "warn",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/control-has-associated-label": "warn",
        "jsx-a11y/interactive-supports-focus": "warn",
        "jsx-a11y/media-has-caption": "warn",
        "jsx-a11y/no-autofocus": "warn",
        "jsx-a11y/no-noninteractive-element-interactions": "warn",
        "jsx-a11y/no-noninteractive-tabindex": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/prefer-tag-over-role": "warn",
        "jsx-a11y/role-supports-aria-props": "warn",
        "no-control-regex": "warn",
        "no-unsafe-optional-chaining": "warn",
        "no-unused-vars": "warn",
        "oxc/erasing-op": "warn",
        "oxc/no-map-spread": "warn",
        "promise/no-callback-in-promise": "warn",
        "react-hooks/exhaustive-deps": "warn",
        "react/globals": "warn",
        "react/immutability": "warn",
        "react/jsx-key": "warn",
        "react/jsx-no-constructed-context-values": "warn",
        "react/no-did-update-set-state": "warn",
        "react/no-object-type-as-default-prop": "warn",
        "react/preserve-manual-memoization": "warn",
        "react/purity": "warn",
        "react/refs": "warn",
        "react/set-state-in-effect": "warn",
        "unicorn/no-new-array": "warn",
        "unicorn/no-thenable": "warn",
        "unicorn/no-useless-spread": "warn",
        "unicorn/prefer-array-find": "warn",
        "unicorn/prefer-string-starts-ends-with": "warn"
      }
    }
  ]
}
